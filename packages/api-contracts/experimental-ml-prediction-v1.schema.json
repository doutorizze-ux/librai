{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librai.app/contracts/experimental-ml-prediction-v1.schema.json",
  "title": "Experimental ML prediction v1",
  "type": "object",
  "required": ["label", "confidence", "model", "experimental"],
  "properties": {
    "label": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "model": {"type": "string"},
    "experimental": {"const": true}
  },
  "additionalProperties": false
}
