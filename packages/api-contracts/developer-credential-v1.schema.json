{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librai.app/contracts/developer-credential-v1.schema.json",
  "title": "Librai Developer Credential v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "scopes"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["translation:recognize", "models:read", "usage:read"]
      }
    },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
