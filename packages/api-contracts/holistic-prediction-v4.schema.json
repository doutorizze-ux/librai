{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librai.app/contracts/holistic-prediction-v4.schema.json",
  "title": "Librai Holistic Temporal Prediction v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "frames"],
  "properties": {
    "format_version": { "const": 4 },
    "frames": {
      "type": "array",
      "minItems": 8,
      "maxItems": 120,
      "description": "Continuous holistic camera window with at least 8 distinct frames. Raw images are never transmitted.",
      "items": { "$ref": "holistic-training-batch-v4.schema.json#/$defs/frame" }
    }
  }
}
