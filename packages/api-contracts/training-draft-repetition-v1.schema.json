{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librai.app/contracts/training-draft-repetition-v1.schema.json",
  "title": "Librai Durable Training Repetition v1",
  "$defs": {
    "captureContext": {
      "type": "object",
      "required": ["platform", "camera_facing"],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "enum": ["android", "ios", "web", "windows", "macos", "linux", "other"]
        },
        "camera_facing": {
          "enum": ["front", "back", "external", "unknown"]
        }
      }
    },
    "request": {
      "type": "object",
      "required": ["capture_id", "sign_name", "format_version", "capture_context", "frames"],
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sign_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "format_version": {
          "const": 3
        },
        "capture_context": {
          "$ref": "#/$defs/captureContext"
        },
        "frames": {
          "type": "array",
          "minItems": 24,
          "maxItems": 180,
          "items": {
            "$ref": "two-hand-sequence-v2.schema.json#/$defs/trainingFrame"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "required": ["sign_name", "repetitions_saved", "required_repetitions", "completed", "duplicate"],
      "additionalProperties": false,
      "properties": {
        "sign_name": {"type": "string"},
        "repetitions_saved": {"type": "integer", "minimum": 1, "maximum": 5},
        "required_repetitions": {"const": 5},
        "completed": {"type": "boolean"},
        "duplicate": {"type": "boolean"}
      }
    },
    "status": {
      "type": "object",
      "required": ["active", "repetitions_saved", "required_repetitions"],
      "additionalProperties": false,
      "properties": {
        "active": {"type": "boolean"},
        "sign_name": {"type": ["string", "null"]},
        "repetitions_saved": {"type": "integer", "minimum": 0, "maximum": 4},
        "required_repetitions": {"const": 5}
      }
    }
  }
}
