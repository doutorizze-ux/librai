{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librai.app/contracts/training-batch-v1.schema.json",
  "title": "Librai Training Batch v1",
  "type": "object",
  "required": ["sign_name", "format_version", "repetitions"],
  "properties": {
    "sign_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "format_version": {"const": 2},
    "repetitions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["frames"],
        "additionalProperties": false,
        "properties": {
          "frames": {
            "type": "array",
            "minItems": 12,
            "maxItems": 180,
            "items": {
              "type": "object",
              "required": ["timestamp_ms", "hands"],
              "additionalProperties": false,
              "properties": {
                "timestamp_ms": {"type": "integer", "minimum": 0},
                "hands": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "required": ["handedness", "score", "landmarks"],
                    "additionalProperties": false,
                    "properties": {
                      "handedness": {"enum": ["Left", "Right", "Unknown"]},
                      "score": {"type": "number", "minimum": 0, "maximum": 1},
                      "landmarks": {
                        "type": "array",
                        "minItems": 21,
                        "maxItems": 21,
                        "items": {
                          "type": "object",
                          "required": ["x", "y", "z"],
                          "additionalProperties": false,
                          "properties": {
                            "x": {"type": "number", "minimum": -0.5, "maximum": 1.5},
                            "y": {"type": "number", "minimum": -0.5, "maximum": 1.5},
                            "z": {"type": "number", "minimum": -3, "maximum": 3}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
