{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librai.app/contracts/assisted-prediction-response-v1.schema.json",
  "title": "Librai Assisted Prediction Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "candidates"],
  "properties": {
    "model": {
      "const": "motion_tcn_v1"
    },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "confidence"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
