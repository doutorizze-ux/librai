{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librai.app/contracts/vlibras-motion-v1.schema.json",
  "title": "Librai VLibras portable landmark motion",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "license",
    "label",
    "fps",
    "duration_seconds",
    "frames"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": { "const": "VLibras" },
    "license": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "fps": { "type": "integer", "minimum": 1, "maximum": 60 },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["time", "body", "left_hand", "right_hand"],
        "properties": {
          "time": { "type": "number", "minimum": 0 },
          "body": { "type": "object" },
          "left_hand": {
            "type": "array",
            "minItems": 21,
            "maxItems": 21
          },
          "right_hand": {
            "type": "array",
            "minItems": 21,
            "maxItems": 21
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
