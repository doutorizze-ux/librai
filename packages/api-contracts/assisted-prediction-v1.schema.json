{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librai.app/contracts/assisted-prediction-v1.schema.json",
  "title": "Librai Assisted Prediction Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "frames"],
  "properties": {
    "format_version": {
      "const": 1
    },
    "frames": {
      "type": "array",
      "minItems": 12,
      "maxItems": 180,
      "items": {
        "$ref": "#/$defs/frame"
      }
    }
  },
  "$defs": {
    "landmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": -0.5, "maximum": 1.5 },
        "y": { "type": "number", "minimum": -0.5, "maximum": 1.5 },
        "z": { "type": "number", "minimum": -3, "maximum": 3 }
      }
    },
    "hand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handedness", "score", "landmarks"],
      "properties": {
        "handedness": {
          "enum": ["Left", "Right", "Unknown"]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "landmarks": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": {
            "$ref": "#/$defs/landmark"
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_ms", "hands"],
      "properties": {
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0
        },
        "hands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/hand"
          }
        }
      }
    }
  }
}
